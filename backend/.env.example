# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_mess_db?retryWrites=true&w=majority

# Security and Authentication
SESSION_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters

# Frontend Client URL (for CORS and Cookie origin)
FRONTEND_URL=http://localhost:3000
